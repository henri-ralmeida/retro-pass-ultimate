camera_position = Vector3(0.42, 0.36, 0.56)
framing_size = 0.28

history_text = "A história do Master System começa no Japão, com o Sega Mark III, lançado em 20 de outubro de 1985. No ano seguinte, a Sega redesenhou o aparelho para o mercado internacional: surgia o Master System, também identificado como Power Base, com o visual preto e vermelho representado aqui.\n\nA família combinava jogos em cartuchos e cartões, além de acessórios que ampliavam as possibilidades de jogar. É importante distinguir as versões: o Master System japonês chegou em 1987 com som FM integrado e conexão direta para os óculos 3-D, recursos que não estavam presentes da mesma forma no Power Base de exportação.\n\nNo Brasil, a Tectoy lançou o Master System em 1989. O console ganhou um lugar especial na memória de quem descobriu os videogames naquela época: ligar a televisão, encaixar o cartucho e transformar a sala em uma nova aventura."
history_credits = "Texto original para RETRO PASS ULTIMATE. Referências históricas: Sega e Tectoy. Marcas pertencem aos respectivos titulares."
history_sources = PackedStringArray("https://www.sega.jp/history/hard/segamark3/index.html", "https://www.sega.jp/history/hard/mastersystem/", "https://www.loja.tectoy.com.br/quem-somos/")
