[resource]
script = ExtResource("1")
system_id = "sega_master_system"
display_name = "Master System"
subtitle = "SEGA  /  CONSOLE"
logo = ExtResource("3")
logo_source = "https://commons.wikimedia.org/wiki/File:Sega-master-system-logo.png"
