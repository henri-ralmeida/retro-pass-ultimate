extends RefCounted
## Pure console-local sampler. No shader, hierarchy changes, input or emulation.
## Runtime owner applies door_delta * each CAPTURED native console-local rest.
## Reversal uses decreasing elapsed time; zero restores exact original node pose.
## Contact is geometric 0.2 mm clearance, not spring/force simulation or OEM rig.
const TOTAL_SECONDS := 1.35
const APPROACH_SECONDS := 0.35
const CONTACT_SECONDS := 0.65
const SEAT_SECONDS := 0.35
const PIVOT := Vector3(0.06099998950958252, 0.027500003576278687, -0.0629250006750226)
const SEAT := Vector3(0.06099998950958252, -0.02089999768743292, -0.05095500499010086)
const HEIGHTS := [0.029700003671273588, 0.02964573939583505, 0.029591942044748062, 0.02953858556824307, 0.02948564442277779, 0.029433093521810727, 0.02938090818777979, 0.02932906410508973, 0.029277537273916444, 0.029226303964639003, 0.029175340672712304, 0.029124624073793515, 0.02907413097893441, 0.02902383828964948, 0.028973722952665718, 0.028923761914154952, 0.028873932073242292, 0.028824210234576056, 0.028774573059733993, 0.02872499701722818, 0.028675458330856607, 0.028625932926132552, 0.028576396374503404, 0.028526823835048308, 0.02847718999331844, 0.02842746899695467, 0.028377634387684147, 0.028327659029259843, 0.028277515030864064, 0.02822717366544837, 0.028176605282427346, 0.028125779214080243, 0.02807466367494378, 0.0280232256533975, 0.027971430794550375, 0.02791924327343189, 0.02786662565736925, 0.027813538756294165, 0.027759941459563883, 0.02770579055769807, 0.027651040547223837, 0.027595643416577956, 0.027539548410735915, 0.02748270177191242, 0.02742504645330135, 0.02736652180238419, 0.027307063209824463, 0.027246601719366034, 0.027185063593450923, 0.027122369828444723, 0.027058435612382213, 0.026993169716989895, 0.026926473814370626, 0.026858241707100064, 0.0267883584585301, 0.02671669940774818, 0.02664312905081575, 0.02656749976649106, 0.026489650360492382, 0.026409404397295826, 0.02632656828226291, 0.02624092904926216, 0.026152251799511153, 0.026060276725631874, 0.025964715640245176, 0.025865247909991375, 0.025761515672544442, 0.02565311818450792, 0.02553960511005328, 0.025420468511095043, 0.02529513323600896, 0.025162945320316946, 0.025023157902312257, 0.024874914009332977, 0.024717225372148807, 0.02454894615531581, 0.02436874012064002, 0.02417503922511434, 0.023965990927917707, 0.023739390442814402, 0.023492592666828224, 0.023222396297486986, 0.02292488932306612, 0.022595239980580384, 0.022227409323647515, 0.021813748818149334, 0.021344425479572916, 0.020806581689844887, 0.020183074923346964, 0.01945053005157646, 0.018576223031487087, 0.0175128870536