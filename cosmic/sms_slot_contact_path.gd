static func sample(elapsed: float) -> Dictionary:
 var t := clampf(elapsed, 0.0, TOTAL_SECONDS) if is_finite(elapsed) else 0.0
 var angle := 0.0
 var origin := SEAT
 if t <= APPROACH_SECONDS:
  origin.y = lerpf(0.2, HEIGHTS[0], _ease(t / APPROACH_SECONDS))
 elif t <= APPROACH_SECONDS + CONTACT_SECONDS:
  var u := _ease((t - APPROACH_SECONDS) / CONTACT_SECONDS) * 100.0
  var i := mini(99, int(floor(u)))
  origin.y = lerpf(HEIGHTS[i], HEIGHTS[i + 1], u - float(i))
  angle = u * 0.9
 else:
  angle = 90.0
  origin.y = lerpf(HEIGHTS[100], SEAT.y, _ease((t - APPROACH_SECONDS - CONTACT_SECONDS) / SEAT_SECONDS))
 var rotation := Basis(Vector3.RIGHT, deg_to_rad(angle))
 var motion := Transform3D(rotation, PIVOT - rotation * PIVOT)
 if angle == 0.0: motion = Transform3D.IDENTITY
 return {"cartridge_pose": Transform3D(Basis.IDENTITY, origin), "door_delta": motion, "door_degrees": angle}

static func _ease(p: float) -> float:
 return p * p * (3.0 - 2.0 * p)
